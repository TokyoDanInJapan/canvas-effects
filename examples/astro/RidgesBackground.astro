---
/**
 * A ridgeline landscape as an Astro component. A sibling of SmokeBackground,
 * PlasmaBackground and RainBackground - mount one, not several: they are all
 * opaque and full-bleed, so two would simply stack.
 *
 * See SmokeBackground.astro for why `transition:persist`, the `astro:page-load`
 * listener and the `dataset` guard are all needed together.
 */
---

<canvas id="ridges" class="ridges" aria-hidden="true" transition:persist></canvas>

<script>
  import { createRidgesBackground } from 'canvas-effects';

  /** Still the readability dial - read a long paragraph before raising it. */
  const AMPLITUDE = { dark: 46, light: 40 };

  function init() {
    const canvas = document.getElementById('ridges') as HTMLCanvasElement | null;
    if (!canvas) return;

    if (canvas.dataset.mounted === '1') return;
    canvas.dataset.mounted = '1';

    const handle = createRidgesBackground(canvas, {
      shading: () => {
        const dark = document.documentElement.classList.contains('dark');
        // These must match your page background.
        return dark ? { base: 18, amplitude: AMPLITUDE.dark } : { base: 255, amplitude: -AMPLITUDE.light };
      },
    });

    if (!handle) canvas.remove();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .ridges {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* Doubly load-bearing: the lines are one field cell wide, so smoothing
       them undoes both the dither and the line art. */
    image-rendering: pixelated;
  }
</style>
