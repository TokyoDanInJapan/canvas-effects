---
/**
 * Fire as an Astro component. A sibling of the other backgrounds - mount one,
 * not several: they are all opaque and full-bleed, so two would simply stack.
 *
 * See SmokeBackground.astro for why `transition:persist`, the `astro:page-load`
 * listener and the `dataset` guard are all needed together.
 */
---

<canvas id="fire" class="fire" aria-hidden="true" transition:persist></canvas>

<script>
  import { createFireBackground } from 'canvas-effects';

  /**
   * Greyscale, where the fire reads as embers at the foot of the page. For
   * actual flame it needs to be louder than its siblings - uncomment TINT,
   * raise this to ~110 and pass `levels: 8`. See the README.
   */
  const AMPLITUDE = { dark: 60, light: 48 };
  // const TINT = [1, 0.45, 0.12] as const;

  function init() {
    const canvas = document.getElementById('fire') as HTMLCanvasElement | null;
    if (!canvas) return;

    if (canvas.dataset.mounted === '1') return;
    canvas.dataset.mounted = '1';

    const handle = createFireBackground(canvas, {
      shading: () => {
        const dark = document.documentElement.classList.contains('dark');
        // These must match your page background.
        return dark
          ? { base: 18, amplitude: AMPLITUDE.dark /*, tint: TINT */ }
          : { base: 255, amplitude: -AMPLITUDE.light /*, tint: TINT */ };
      },
    });

    if (!handle) canvas.remove();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .fire {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    image-rendering: pixelated;
  }
</style>
