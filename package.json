{
  "name": "canvas-effects",
  "version": "1.14.0",
  "description": "Six animated, ordered-dithered greyscale backgrounds for a 2D canvas: a Stable Fluids smoke solver, a domain-warped plasma, digital rain, a ridgeline landscape, cellular fire, and metaballs.",
  "keywords": [
    "canvas",
    "background",
    "dither",
    "bayer",
    "ordered-dithering",
    "fluid-simulation",
    "stable-fluids",
    "smoke",
    "plasma",
    "domain-warp",
    "fbm",
    "noise",
    "generative",
    "matrix",
    "digital-rain",
    "ridgeline",
    "joyplot",
    "hidden-line-removal",
    "fire",
    "doom-fire",
    "demoscene",
    "metaballs",
    "implicit-surface"
  ],
  "license": "MIT",
  "author": "Daniel Hebberd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokyoDanInJapan/canvas-effects.git"
  },
  "homepage": "https://github.com/TokyoDanInJapan/canvas-effects#readme",
  "bugs": {
    "url": "https://github.com/TokyoDanInJapan/canvas-effects/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "vite",
    "demo": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "fix": "eslint --fix . && prettier -w .",
    "ci": "npm run check && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
