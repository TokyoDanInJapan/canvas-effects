{
  "name": "canvas-effects",
  "version": "2.4.0",
  "description": "Seven animated, ordered-dithered greyscale backgrounds for a 2D canvas: a Stable Fluids smoke solver, a domain-warped plasma, digital rain, a ridgeline landscape, metaballs, a reciprocal tunnel, and a Mandelbrot zoomer.",
  "keywords": [
    "canvas",
    "background",
    "dither",
    "bayer",
    "ordered-dithering",
    "fluid-simulation",
    "stable-fluids",
    "smoke",
    "plasma",
    "domain-warp",
    "fbm",
    "noise",
    "generative",
    "matrix",
    "digital-rain",
    "ridgeline",
    "joyplot",
    "hidden-line-removal",
    "demoscene",
    "metaballs",
    "implicit-surface",
    "tunnel",
    "mandelbrot",
    "fractal",
    "distance-estimator"
  ],
  "license": "MIT",
  "author": "Daniel Hebberd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokyoDanInJapan/canvas-effects.git"
  },
  "homepage": "https://github.com/TokyoDanInJapan/canvas-effects#readme",
  "bugs": {
    "url": "https://github.com/TokyoDanInJapan/canvas-effects/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "vite",
    "demo": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:package",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "fix": "eslint --fix . && prettier -w .",
    "ci": "npm run check && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.5.0",
    "publint": "^0.3.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
